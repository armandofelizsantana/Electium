    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>fe3a2dc5-bffd-46e7-a7d8-58ac3cec02dd</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Electium.Application\Electium.Application.csproj" />
