@model Electium.Web.ViewModels.LeaderDashboardViewModel

@{
    ViewData["Title"] = "Inicio del dirigente";
}

<h1>Inicio del dirigente político</h1>

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-warning" role="alert">
        @errorMessage
    </div>
}

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

<p>La sesión del dirigente está activa, @Model.FullName.</p>

<section class="card shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h4">Partido asignado</h2>

        @if (string.IsNullOrWhiteSpace(Model.PoliticalPartyName))
        {
            <p class="mb-0">No hay un partido asignado a esta cuenta.</p>
        }
        else
        {
            <div class="d-flex flex-wrap align-items-center gap-3">
                @if (!string.IsNullOrWhiteSpace(Model.PoliticalPartyLogoPath))
                {
                    <img src="@Model.PoliticalPartyLogoPath"
                         alt="Logo de @Model.PoliticalPartyName"
                         class="img-thumbnail"
                         style="max-width: 110px; max-height: 90px;" />
                }

                <div>
                    <p class="mb-1">
                        <strong>Partido:</strong> @Model.PoliticalPartyName
                    </p>
                    <p class="mb-0">
                        <strong>Siglas:</strong>
                        @(string.IsNullOrWhiteSpace(Model.PoliticalPartyAcronym)
                            ? "No registradas"
                            : Model.PoliticalPartyAcronym)
                    </p>
                </div>
            </div>
        }
    </div>
</section>

<section class="mb-4">
    <h2 class="h4">Resumen del partido</h2>

    <div class="row g-3">
        <div class="col-sm-6 col-lg">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h6">Candidatos activos</h3>
                    <p class="display-6 mb-0">@Model.ActiveCandidateCount</p>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h6">Candidatos inactivos</h3>
                    <p class="display-6 mb-0">@Model.InactiveCandidateCount</p>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h6">Alianzas vigentes</h3>
                    <p class="display-6 mb-0">@Model.ActiveAllianceCount</p>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h6">Solicitudes pendientes por responder</h3>
                    <p class="display-6 mb-0">
                        @Model.PendingIncomingAllianceRequestCount
                    </p>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h6">Candidatos asignados a puestos</h3>
                    <p class="display-6 mb-0">@Model.AssignedCandidateCount</p>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-controller="Candidates"
       asp-action="Index"
       class="btn btn-primary">
        Candidatos
    </a>

    <a asp-controller="LeaderNominations"
       asp-action="Index"
       class="btn btn-primary">
        Asignar candidato a puesto
    </a>

    <a asp-controller="LeaderAlliances"
       asp-action="Index"
       class="btn btn-primary">
        Alianzas políticas
    </a>
</div>

<form asp-controller="Account" asp-action="Logout" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-outline-secondary">
        Cerrar sesión
    </button>
</form>