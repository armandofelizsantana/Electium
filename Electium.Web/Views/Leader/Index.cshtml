@model Electium.Web.ViewModels.LeaderDashboardViewModel

@{
    ViewData["Title"] = "Inicio del dirigente";
}

<h1>Inicio del dirigente político</h1>

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-warning" role="alert">
        @errorMessage
    </div>
}

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

<p>La sesión del dirigente está activa, @Model.FullName.</p>

<div class="alert alert-info" role="status">
    <strong>Partido asignado:</strong>
    @(string.IsNullOrWhiteSpace(Model.PoliticalPartyName)
        ? "No hay un partido asignado a esta cuenta."
        : Model.PoliticalPartyName)
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-controller="Candidates"
       asp-action="Index"
       class="btn btn-primary">
        Candidatos
    </a>

    <a asp-controller="LeaderNominations"
       asp-action="Index"
       class="btn btn-primary">
        Asignar candidato a puesto
    </a>

    <a asp-controller="LeaderAlliances"
       asp-action="Index"
       class="btn btn-primary">
        Alianzas políticas
    </a>
</div>

<form asp-controller="Account" asp-action="Logout" method="post">
    <button type="submit" class="btn btn-outline-secondary">
        Cerrar sesión
    </button>
</form>