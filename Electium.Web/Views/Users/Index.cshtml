@model IEnumerable<Electium.Web.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

<h1>Administrar usuarios</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Crear usuario</a>
</p>

@if (!Model.Any())
{
    <p>No hay usuarios registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Correo</th>
                    <th>Usuario</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Email</td>
                    <td>@user.UserName</td>
                    <td>@user.RoleName</td>
                    <td>@(user.IsActive ? "Activo" : "Inactivo")</td>
                    <td class="d-flex flex-wrap gap-2">
                        <a asp-action="Edit"
                           asp-route-id="@user.Id"
                           class="btn btn-sm btn-warning">
                            Editar
                        </a>

                        <a asp-action="ConfirmSetActive"
                           asp-route-id="@user.Id"
                           class="btn btn-sm @(user.IsActive ? "btn-secondary" : "btn-success")">
                            @(user.IsActive ? "Desactivar" : "Activar")
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}