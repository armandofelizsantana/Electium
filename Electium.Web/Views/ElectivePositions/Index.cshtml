@model IEnumerable<Electium.Web.ViewModels.ElectivePositionListViewModel>

@{
    ViewData["Title"] = "Puestos electivos";
}

<h1>Puestos electivos</h1>

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">
        Crear puesto
    </a>
</p>

@if (!Model.Any())
{
    <p>No hay puestos electivos registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var position in Model)
                {
                    <tr>
                        <td>@position.Name</td>
                        <td>@position.Description</td>
                        <td>
                            @if (position.IsActive)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit"
                                   asp-route-id="@position.Id"
                                   class="btn btn-sm btn-warning">
                                    Editar
                                </a>

                                <a asp-action="ConfirmSetActive"
                                   asp-route-id="@position.Id"
                                   asp-route-isActive="@(!position.IsActive)"
                                   class="btn btn-sm @(position.IsActive ? "btn-secondary" : "btn-success")">
                                    @(position.IsActive ? "Desactivar" : "Activar")
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}