@model Electium.Web.ViewModels.LeaderAllianceDashboardViewModel
@using Electium.Domain.Enums

@{
    ViewData["Title"] = "Alianzas políticas";
}

<h1>Alianzas políticas</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" id="allianceSuccess" role="alert">
        @success
    </div>
}

<section class="mb-5">
    <h2>Solicitudes recibidas pendientes</h2>

    @if (!Model.IncomingRequests.Any())
    {
        <p>No tienes solicitudes pendientes por responder.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Partido solicitante</th>
                        <th>Fecha de solicitud</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.IncomingRequests)
                    {
                        <tr>
                            <td>
                                @request.RequestingPartyName
                                (@request.RequestingPartyAcronym)
                            </td>
                            <td>@request.RequestedAtUtc.ToLocalTime()</td>
                            <td>
                                <a asp-action="ConfirmResponse"
                                   asp-route-id="@request.Id"
                                   asp-route-accept="true"
                                   class="btn btn-sm btn-success">
                                    Aceptar
                                </a>

                                <a asp-action="ConfirmResponse"
                                   asp-route-id="@request.Id"
                                   asp-route-accept="false"
                                   class="btn btn-sm btn-danger">
                                    Rechazar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2>Solicitudes enviadas</h2>

        <a asp-action="Create" class="btn btn-primary">
            Nueva solicitud
        </a>
    </div>

    @if (!Model.OutgoingRequests.Any())
    {
        <p>No has enviado solicitudes de alianza.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Partido destino</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.OutgoingRequests)
                    {
                        <tr>
                            <td>
                                @request.ReceivingPartyName
                                (@request.ReceivingPartyAcronym)
                            </td>
                            <td>@request.RequestedAtUtc.ToLocalTime()</td>
                            <td>
                                @(request.Status switch
                                {
                                    AllianceRequestStatus.Pending => "En espera de respuesta",
                                    AllianceRequestStatus.Accepted => "Aceptada",
                                    AllianceRequestStatus.Rejected => "Rechazada",
                                    _ => "Desconocido"
                                })
                            </td>
                            <td>
                                <a asp-action="ConfirmDelete"
                                   asp-route-id="@request.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Retirar solicitud
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="mb-4">
    <h2>Alianzas vigentes</h2>

    @if (!Model.ActiveAlliances.Any())
    {
        <p>Tu partido no tiene alianzas vigentes.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Partido aliado</th>
                        <th>Fecha de aceptación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alliance in Model.ActiveAlliances)
                    {
                        <tr>
                            <td>
                                @alliance.AlliedPartyName
                                (@alliance.AlliedPartyAcronym)
                            </td>
                            <td>@alliance.AcceptedAtUtc.ToLocalTime()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<p>
    <a asp-controller="Leader" asp-action="Index" class="btn btn-secondary">
        Volver al portal del dirigente
    </a>
</p>

@section Scripts {
    <script>
        setTimeout(() => {
            const message = document.getElementById("allianceSuccess");

            if (message) {
                message.style.transition = "opacity 500ms";
                message.style.opacity = "0";
                setTimeout(() => message.remove(), 500);
            }
        }, 3000);
    </script>
}