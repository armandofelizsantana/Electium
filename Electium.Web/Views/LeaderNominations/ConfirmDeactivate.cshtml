@model Electium.Web.ViewModels.ConfirmDeactivateNominationViewModel

@{
    ViewData["Title"] = "Retirar asignación";
}

<h1>Retirar asignación</h1>

<div class="alert alert-warning" role="alert">
    La asignación se marcará como retirada. El registro se conservará
    en el historial.
</div>

<p>
    ¿Confirmas retirar a <strong>@Model.CandidateFullName</strong>
    del puesto <strong>@Model.ElectivePositionName</strong>?
</p>

<form asp-action="Deactivate" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">
        Confirmar retiro
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>