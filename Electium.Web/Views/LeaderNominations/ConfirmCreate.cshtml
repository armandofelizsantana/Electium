@model Electium.Web.ViewModels.ConfirmCreateNominationViewModel

@{
    ViewData["Title"] = "Confirmar asignación";
}

<h1>Confirmar asignación</h1>

<div class="alert alert-info" role="alert">
    Confirma que quieres asignar este candidato al puesto indicado.
</div>

<dl class="row">
    <dt class="col-sm-3">Candidato</dt>
    <dd class="col-sm-9">@Model.CandidateFullName</dd>

    <dt class="col-sm-3">Partido de origen</dt>
    <dd class="col-sm-9">@Model.CandidatePartyName</dd>

    <dt class="col-sm-3">Puesto</dt>
    <dd class="col-sm-9">@Model.ElectivePositionName</dd>
</dl>

<form asp-action="CreateConfirmed" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="CandidateId" type="hidden" />
    <input asp-for="ElectivePositionId" type="hidden" />

    <button type="submit" class="btn btn-primary">
        Confirmar asignación
    </button>
    <a asp-action="Create" class="btn btn-secondary">
        Volver
    </a>
</form>